# ── Formspree Form IDs ──────────────────────────────────────────────
# Create forms at https://formspree.io and paste the form IDs here.
# These are public and safe to expose in the client (VITE_ prefix).
# Replace the placeholder values with your actual Formspree form IDs.

# General inquiries form ID (e.g., "xyzabc12")
VITE_FORMSPREE_GENERAL_ID=

# Career / job application form ID
VITE_FORMSPREE_CAREER_ID=

# Quote request form ID
VITE_FORMSPREE_QUOTE_ID=
